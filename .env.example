# Database (PostgreSQL - only used if USE_SQLITE=false)
DB_HOST=localhost
DB_PORT=5432
DB_USER=rolsito
DB_PASSWORD=rolsito123
DB_NAME=rolsito

# SQLite (used by default in development)
USE_SQLITE=true
SQLITE_DB_PATH=./rolsito.dev.db

# Redis (only used if USE_REDIS_MOCK=false)
REDIS_HOST=localhost
REDIS_PORT=6379
USE_REDIS_MOCK=true

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=7d

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key

# Server
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
